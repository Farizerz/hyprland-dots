{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "title",
      "key": ""
    },
    {
      "type": "custom",
      "format": "\u001b[36m╭──\u001b[91mSoftware\u001b[36m──╮"
    },
    // "host",
    {
      "type": "os",
      "key": "│  OS       │"
    },
    {
      "type": "kernel",
      "key": "│  Kernel   │"
    },
    {
      "type": "de",
      "key": "│ 󰪫 DE       │"
    },
    {
      "type": "wm",
      "key": "│ 󱂬 WM       │"
    },
    {
      "type": "packages",
      "key": "│  Packages │"
    },
    {
      "type": "terminal",
      "key": "│  Terminal │"
    },
    {
      "type": "shell",
      "key": "│  Shell    │"
    },
    // "wmtheme",
    // "theme",
    // "icons",
    // {
    //   "type": "font",
    //   "key": "│  Font     │"
    // },
    {
      "type": "custom",
      "format": "\u001b[36m├──\u001b[91mHardware\u001b[36m──┤"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display  │",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "cpu",
      "key": "│  CPU      │"
    },
    {
      "type": "gpu",
      "key": "│ 󱎴 GPU      │"
    },
    {
      "type": "memory",
      "key": "│  Memory   │"
    },
    // "battery",
    // "poweradapter",
    {
      "type": "custom",
      "format": "\u001b[36m├────\u001b[91mMisc\u001b[36m────┤"
    },
    {
      "type": "command",
      "key": "│  OS Age   │",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "│ 󰥔 Uptime   │"
    },
    {
      "type": "custom",
      "format": "\u001b[36m╰────────────╯"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ],
  "display": {
    "separator": " "
  },
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt"
  }
}
