{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "title",
      "key": " "
    },
    {
      "type": "custom",
      "format": "\u001b[36m╭───\u001b[91mOS\u001b[36m───╮"
    },
    // "host",
    {
      "type": "os",
      "key": "│  Dist │"
    },
    {
      "type": "kernel",
      "key": "│  Krnl │"
    },
    {
      "type": "de",
      "key": "│ 󰪫 DE   │"
    },
    {
      "type": "wm",
      "key": "│ 󱂬 WM   │"
    },
    {
      "type": "packages",
      "key": "│  Pkgs │"
    },
    {
      "type": "terminal",
      "key": "│  Term │"
    },
    {
      "type": "shell",
      "key": "│  Sh   │"
    },
    // "wmtheme",
    // "theme",
    // "icons",
    // {
    //   "type": "font",
    //   "key": "│  Font │"
    // },
    {
      "type": "custom",
      "format": "\u001b[36m├───\u001b[91mPC\u001b[36m───┤"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Res  │",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "cpu",
      "key": "│  CPU  │"
    },
    {
      "type": "gpu",
      "key": "│ 󱎴 GPU  │",
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key": "│  RAM  │"
    },
    // "battery",
    // "poweradapter",
    {
      "type": "custom",
      "format": "\u001b[36m├──\u001b[91mMisc\u001b[36m──┤"
    },
    {
      "type": "command",
      "key": "│  Age  │",
      // "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); years=$((days_difference / 365)); remaining_days=$((days_difference % 365)); if [ $years -gt 0 ]; then months=$((remaining_days / 31)); days=$((remaining_days % 31)); else months=$((remaining_days / 30)); days=$((remaining_days % 30)); fi; output=''; if [ $years -gt 0 ]; then output+=\"$years year\"; if [ $years -gt 1 ]; then output+='s'; fi; if [ $months -gt 0 ] || [ $days -gt 0 ]; then output+=', '; fi; fi; if [ $months -gt 0 ]; then output+=\"$months month\"; if [ $months -gt 1 ]; then output+='s'; fi; if [ $days -gt 0 ]; then output+=', '; fi; elif [ $years -eq 0 ] && [ $days -gt 0 ]; then output+=\"$days day\"; if [ $days -gt 1 ]; then output+='s'; fi; fi; if [ $days -gt 0 ] && { [ $years -gt 0 ] || [ $months -gt 0 ]; }; then output+=\"$days day\"; if [ $days -gt 1 ]; then output+='s'; fi; fi; echo $output"
    },
    {
      "type": "uptime",
      "key": "│ 󰥔 Up   │"
    },
    {
      "type": "custom",
      "format": "\u001b[36m╰────────╯"
    },
    // {
    //   "type": "colors",
    //   "symbol": "circle"
    // }
    {
      "type": "custom",
      "format": "\u001b[90m \u001b[91m \u001b[92m \u001b[93m \u001b[94m \u001b[95m \u001b[96m \u001b[97m"
    }
  ],
  "display": {
    "separator": " "
  },
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt"
  }
}
