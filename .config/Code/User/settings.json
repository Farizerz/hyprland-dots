{
  "editor.fontFamily": "'JetBrainsMono Nerd Font Propo', 'monospace', monospace",
  "editor.tabSize": 2,
  "editor.fontWeight": "500",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "workbench.settings.applyToAllProfiles": [],
  "workbench.colorCustomizations": {
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "#2393D7",
    "tab.activeBackground": "#a4c9e600",
    "tab.activeForeground": "#2393D7",
    "tab.hoverBackground": "#a4c9e600",
    "tab.inactiveBackground": "#00000095",
    "tab.inactiveForeground": "#a4c9e650",
    "tab.border": "#00000000",
    "activityBar.background": "#05091D",
    "activityBar.activeBorder": "#a4c9e6",
    "activityBar.border": "#a4c9e620",
    "activityBarBadge.background": "#a4c9e6",
    "activityBarBadge.foreground": "#05091D",
    "editor.background": "#05091D",
    "editor.lineHighlightBorder": "#00000000",
    "editor.lineHighlightBackground": "#a4c9e610",
    "editor.selectionBackground": "#a4c9e650",
    "editorGroup.border": "#000000",
    "editorGroupHeader.border": "#00000000",
    "editorGroupHeader.tabsBackground": "#05091D",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorIndentGuide.background1": "#a4c9e620",
    "editorIndentGuide.activeBackground1": "#a4c9e650",
    "editorLineNumber.activeForeground": "#2393D7",
    "editorLineNumber.dimmedForeground": "#2393D740",
    "editorLineNumber.foreground": "#2393D770",
    "editorStickyScroll.shadow": "#00000000",
    "editorSuggestWidget.background": "#05091D",
    "list.inactiveSelectionBackground": "#ffffff15",
    "list.activeSelectionBackground": "#ffffff30",
    "list.focusBackground": "#ffffff20",
    "list.focusOutline": "#00000000",
    "list.hoverBackground": "#ffffff20",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#a4c9e620",
    "scrollbarSlider.hoverBackground": "#a4c9e630",
    "scrollbarSlider.activeBackground": "#a4c9e630",
    "sideBar.background": "#05091D",
    "sideBar.border": "#a4c9e620",
    "sideBarSectionHeader.background": "#ffffff20",
    "statusBar.background": "#05091D",
    "statusBar.border": "#a4c9e610",
    "statusBar.foreground": "#a4c9e6",
    "statusBarItem.remoteForeground": "#05091D",
    "statusBarItem.remoteBackground": "#a4c9e680",
    "panel.background": "#05091D",
    "panelTitle.activeBorder": "#a4c9e6",
    "panelTitleBadge.background": "#a4c9e6",
    "panelTitleBadge.foreground": "#05091D",
    "terminal.background": "#05091D"
  },
  "workbench.editorAssociations": {
    "*.svg": "default"
  },
  "window.titleBarStyle": "native",
  "github.copilot.advanced": {},
  "github.copilot.enable": {
    "*": false
  },
  "settingsSync.ignoredSettings": [],
  "workbench.layoutControl.enabled": false,
  "chat.commandCenter.enabled": false,
  "window.commandCenter": false,
  "window.menuStyle": "custom",
  "window.menuBarVisibility": "compact",
  "json.schemas": [],
  "workbench.editor.editorActionsLocation": "hidden",
  "editor.stickyScroll.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.fontSize": 14.8,
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": true,
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "window.customTitleBarVisibility": "never",
  "workbench.activityBar.location": "hidden",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["comment", "comment.block.documentation"],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  }
}
