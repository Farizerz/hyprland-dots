{
  "editor.fontFamily": "'JetBrainsMono Nerd Font Propo', 'monospace', monospace",
  "editor.tabSize": 2,
  "editor.fontWeight": "500",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "workbench.settings.applyToAllProfiles": [],
  "workbench.colorCustomizations": {
    "activityBar.background": "#0f1c07",
    "activityBar.activeBorder": "#c7d1ba",
    "activityBarBadge.background": "#c7d1ba",
    "activityBarBadge.foreground": "#0f1c07",
    "editor.background": "#0f1c07",
    "editorGroupHeader.tabsBackground": "#0f1c07",
    "panel.background": "#0f1c07",
    "panelTitle.activeBorder": "#c7d1ba",
    "panelTitleBadge.background": "#c7d1ba",
    "panelTitleBadge.foreground": "#0f1c07",
    "sideBar.background": "#0f1c07",
    "sideBarSectionHeader.background": "#e5c6be20",
    "statusBar.background": "#0f1c07",
    "tab.activeBorderTop": "#c7d1ba",
    "tab.activeBackground": "#c7d1ba20",
    "tab.inactiveBackground": "#0f1c07",
    "terminal.background": "#0f1c07"
  },
  "workbench.editorAssociations": {
    "*.svg": "default"
  },
  "window.titleBarStyle": "native",
  "github.copilot.advanced": {},
  "github.copilot.enable": {
    "*": false
  },
  "settingsSync.ignoredSettings": [],
  "workbench.layoutControl.enabled": false,
  "chat.commandCenter.enabled": false,
  "window.commandCenter": false,
  "window.menuStyle": "custom",
  "window.menuBarVisibility": "compact",
  "window.customTitleBarVisibility": "never",
  "json.schemas": [],
  "workbench.editor.editorActionsLocation": "hidden",
  "editor.stickyScroll.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.fontSize": 14.8,
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "workbench.activityBar.location": "hidden",
  "editor.mouseWheelZoom": true,
  "workbench.editor.enablePreviewFromCodeNavigation": true
}
