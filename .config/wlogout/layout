{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "   Lock  ",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "  Logout ",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "  Sleep  ",
    "keybind" : "u"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown ",
    "keybind" : "s"
}
{
    "label" : "rebootwindows",
    "action" : "sudo efibootmgr --bootnext 0000 && systemctl reboot",
    "text" : " Windows ",
    "keybind" : "w"
},
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : " Restart ",
    "keybind" : "r"
},