! X colors.
! Generated by 'wal'
*foreground:        #88c0d8
*background:        #010D15
*.foreground:       #88c0d8
*.background:       #010D15
emacs*foreground:   #88c0d8
emacs*background:   #010D15
URxvt*foreground:   #88c0d8
XTerm*foreground:   #88c0d8
UXTerm*foreground:  #88c0d8
URxvt*background:   [100]#010D15
XTerm*background:   #010D15
UXTerm*background:  #010D15
URxvt*cursorColor:  #88c0d8
XTerm*cursorColor:  #88c0d8
UXTerm*cursorColor: #88c0d8
URxvt*borderColor:  [100]#010D15

! Colors 0-15.
*.color0: #010D15
*color0:  #010D15
*.color1: #0F627C
*color1:  #0F627C
*.color2: #405169
*color2:  #405169
*.color3: #08548B
*color3:  #08548B
*.color4: #106994
*color4:  #106994
*.color5: #0D6FAC
*color5:  #0D6FAC
*.color6: #2E76B3
*color6:  #2E76B3
*.color7: #88c0d8
*color7:  #88c0d8
*.color8: #5f8697
*color8:  #5f8697
*.color9: #0F627C
*color9:  #0F627C
*.color10: #405169
*color10:  #405169
*.color11: #08548B
*color11:  #08548B
*.color12: #106994
*color12:  #106994
*.color13: #0D6FAC
*color13:  #0D6FAC
*.color14: #2E76B3
*color14:  #2E76B3
*.color15: #88c0d8
*color15:  #88c0d8

! Black color that will not be affected by bold highlighting.
*.color66: #010D15
*color66:  #010D15

! Xclock colors.
XClock*foreground: #88c0d8
XClock*background: #010D15
XClock*majorColor:  rgba:88/c0/d8/ff
XClock*minorColor:  rgba:88/c0/d8/ff
XClock*hourColor:   rgba:88/c0/d8/ff
XClock*minuteColor: rgba:88/c0/d8/ff
XClock*secondColor: rgba:88/c0/d8/ff

! Set depth to make transparency work.
URxvt*depth: 32
